# ============================================================================
# NOTES.md web application — environment variables
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local (it is gitignored).
# ============================================================================

# Next.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (backend only — never expose to the browser)
# Use the service role secret key. All DB calls go through Next.js route
# handlers; the browser never talks to Supabase directly.
# Apply the SQL files in supabase/migrations to this same Supabase project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Google OAuth (Google Cloud Console)
# Configure a Web Application client. Authorized redirect URI:
#   https://notesmdweb.vercel.app/api/auth/google/callback
# For local development: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application session configuration
SESSION_SECRET=a_random_string_used_to_sign_cookies  # generate with: openssl rand -base64 32
SESSION_MAX_AGE_SECONDS=1209600                       # 14 days

# VS Code device-linking callback (handled by the web app)
# The VS Code extension opens this URL in an external browser.
NEXT_PUBLIC_VSCODE_CALLBACK_BASE_URL=http://localhost:3000
