{
  "name": "notes-md",
  "displayName": "NOTES.md - Markdown Notes",
  "description": "A simple Markdown note manager for VS Code",
  "version": "0.2.0",
  "publisher": "sujanroydev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sujanroydev/notes-md.git"
  },
  "bugs": {
    "url": "https://github.com/sujanroydev/notes-md/issues"
  },
  "homepage": "https://github.com/sujanroydev/notes-md",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "notes",
    "note-taking",
    "todo",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "notesMd",
          "title": "Notes.md",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "notesMd": [
        {
          "id": "notesMd.view",
          "name": "Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "notes-md.createNote",
        "title": "Notes.md: New Note",
        "icon": "$(add)"
      },
      {
        "command": "notes-md.openNote",
        "title": "Notes.md: Open Note"
      },
      {
        "command": "notes-md.renameNote",
        "title": "Notes.md: Rename Note",
        "icon": "$(edit)"
      },
      {
        "command": "notes-md.deleteNote",
        "title": "Notes.md: Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "notes-md.signIn",
        "title": "Notes.md: Connect to Web"
      },
      {
        "command": "notes-md.signOut",
        "title": "Notes.md: Disconnect from Web",
        "icon": "$(sign-out)"
      },
      {
        "command": "notes-md.sync",
        "title": "Notes.md: Sync with Web",
        "icon": "$(sync)"
      }
    ],
    "configuration": {
      "title": "NOTES.md",
      "properties": {
        "notes-md.webBaseUrl": {
          "type": "string",
          "default": "https://notesmdweb.vercel.app",
          "description": "Base URL of the NOTES.md web app used for account linking and note synchronization."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "notes-md.createNote",
          "when": "view == notesMd.view",
          "group": "navigation"
        },
        {
          "command": "notes-md.sync",
          "when": "view == notesMd.view",
          "group": "navigation@2"
        },
        {
          "command": "notes-md.signOut",
          "when": "view == notesMd.view && notesMd.signedIn",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "notes-md.renameNote",
          "title": "Rename",
          "icon": "$(edit)",
          "when": "view == notesMd.view && viewItem == notesMd.note",
          "group": "notesMd@1"
        },
        {
          "command": "notes-md.deleteNote",
          "title": "Delete",
          "icon": "$(trash)",
          "when": "view == notesMd.view && viewItem == notesMd.note",
          "group": "notesMd@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.135.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
